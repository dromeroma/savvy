# =============================================================================
# SavvyCore Environment Configuration (all vars prefixed with SAVVY_)
# =============================================================================

# Application
SAVVY_APP_NAME=SavvyCore
SAVVY_APP_VERSION=0.1.0
SAVVY_APP_ENV=dev
SAVVY_LOG_LEVEL=INFO

# Database (PostgreSQL via Supabase)
# Format: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SAVVY_DATABASE_URL=postgresql+asyncpg://postgres.cdvwtgfyetonidjfwflt:[YOUR-DB-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Redis
SAVVY_REDIS_URL=redis://localhost:6379/0

# JWT
SAVVY_JWT_SECRET_KEY=change-me-to-a-random-256-bit-secret
SAVVY_JWT_ALGORITHM=HS256
SAVVY_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
SAVVY_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
SAVVY_CORS_ORIGINS=["http://localhost:4200","http://localhost:3000"]

# =============================================================================
# Seguridad (PRODUCCIÓN)
# =============================================================================
# Clave dedicada para cifrar secretos en reposo (API key de IA, token WhatsApp).
# Independiente del JWT secret: rotar el JWT no debe destruir los secretos.
# Generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
SAVVY_ENCRYPTION_KEY=

# RLS — aislamiento multi-tenant a nivel de base de datos.
# Activar SOLO después de correr setup_rls_policies.py + setup_rls_role.py y de
# verificar con verify_rls.py + smoke en staging. Rollback = volver a false.
SAVVY_RLS_ENFORCE=false
SAVVY_RLS_APP_ROLE=savvy_app

# =============================================================================
# IA (SavvyAI)  — la API key de Claude se configura desde /platform/ai (cifrada)
# =============================================================================
# Kill-switch de gasto de IA (USD/día). 0 = sin límite.
SAVVY_AI_DAILY_USD_LIMIT_GLOBAL=1.0
SAVVY_AI_DAILY_USD_LIMIT_ORG=10.0

# =============================================================================
# Automatizaciones (SavvyFlow) — cron de agentes
# =============================================================================
# Secreto para que el cron de Render dispare /automations/evaluate-all.
# Generar uno aleatorio. El cron envía el header X-Cron-Secret con este valor.
SAVVY_CRON_SECRET=

# =============================================================================
# Observabilidad
# =============================================================================
SAVVY_SENTRY_DSN=
SAVVY_SENTRY_TRACES_SAMPLE_RATE=0.1
SAVVY_LOG_JSON=false
SAVVY_SLOW_REQUEST_MS=2000

# =============================================================================
# Pool de conexiones (opcional)
# =============================================================================
# SAVVY_DB_POOL_SIZE=5
# SAVVY_DB_MAX_OVERFLOW=5
# SAVVY_SQL_ECHO=0
